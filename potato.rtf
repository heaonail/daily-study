func get_move_direction()->Vector2:\par
\tab if is_instance_valid(Global.player) and self.global_position.distance_to(Global.player.global_position)>36:\par
\tab\tab move_direction=global_position.direction_to(Global.player.global_position)\par
\tab else:\par
\tab\tab move_direction=Vector2.ZERO\par
\tab for area:Area2D in area_push.get_overlapping_areas():\par
\tab\tab var temp=global_position-area.global_position\par
\tab\tab move_direction+=temp.normalized()*push/max(temp.length(),4)\par
\tab return move_direction\par
func animation()->void:\par
\tab if is_instance_valid(Global.player):\par
\tab\tab var temp=global_position.direction_to(Global.player.global_position)\par
\tab\tab if temp.x>0:\par
\tab\tab\tab animate.flip_h=false\par
\tab\tab if temp.x<0:\par
\tab\tab\tab animate.flip_h=true\par
\tab if move_direction.length()==0:\par
\tab\tab animate.play("idle")\par
\tab else :\par
\tab\tab animate.play("run")\par
