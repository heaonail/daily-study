func calculate_tier_odds(current_wave:int)->Array:\par
\tab var common_odds:float=0.0\par
\tab var epic_odds:float=0.0\par
\tab var rare_odds:float=0.0\par
\tab var legendary_odds:float=0.0\par
\tab\par
\tab if current_wave>=ODDS.epic.start_wave:\par
\tab\tab epic_odds=min(1.0,(current_wave-1)*ODDS.epic.base_multiple)\par
\tab if current_wave>=ODDS.rare.start_wave:\par
\tab\tab rare_odds=min(1.0,(current_wave-3)*ODDS.rare.base_multiple)\par
\tab if current_wave>=ODDS.legendary.start_wave:\par
\tab\tab legendary_odds=min(1.0,(current_wave-7)*ODDS.legendary.base_multiple)\par
\tab var luck_effect:float=1.0+float(Global.player.stats.luck)/100\par
\tab epic_odds*=luck_effect\par
\tab rare_odds*=luck_effect\par
\tab legendary_odds*=luck_effect\par
\tab var total_odds:float=epic_odds+rare_odds+legendary_odds\par
\tab if total_odds>1:\par
\tab\tab var normalize_odds:float=1/(total_odds)\par
\tab\tab epic_odds*=normalize_odds\par
\tab\tab rare_odds*=normalize_odds\par
\tab\tab legendary_odds*=normalize_odds\par
\tab\tab total_odds=1.0\par
\tab common_odds=1.0-total_odds\par
\tab #print("wave:%d c_odds:%.2f e_odds:%.2f r_odds:%.2f,l_odds:%.2f"%[current_wave,common_odds,epic_odds,rare_odds,legendary_odds])\par
\tab return [max(0,common_odds),max(0,epic_odds),max(0,rare_odds),max(0,legendary_odds)]\par
\par
func select_item_offer(item_pool:Array,current_wave:int)->Array:\par
\tab var tier_odds:Array=calculate_tier_odds(current_wave)\par
\tab #[0.7,0.2,0.08,0.02]\par
\tab var legendary_limit:float=tier_odds[3]\par
\tab var rare_limit:float=legendary_limit+tier_odds[2]\par
\tab var epic_limit:float=rare_limit+tier_odds[1]\par
\tab var offer_item:Array=[]\par
\tab while offer_item.size()<4:\par
\tab\tab var roll:float=randf()\par
\tab\tab var chosen_tier_index:int=0\par
\tab\tab if roll<=legendary_limit:\par
\tab\tab\tab chosen_tier_index=3\par
\tab\tab elif roll<=rare_limit:\par
\tab\tab\tab chosen_tier_index=2\par
\tab\tab elif roll<=epic_limit:\par
\tab\tab\tab chosen_tier_index=1\par
\tab\tab var potential_items:Array=[]\par
\tab\tab var current_iter_index:int=chosen_tier_index\par
\tab\tab while  potential_items.is_empty() and current_iter_index>=0:\par
\tab\tab\tab potential_items=item_pool.filter(func(item:Item): return item.item_tier==current_iter_index)\par
\tab\tab\tab if potential_items.is_empty():\par
\tab\tab\tab\tab current_iter_index-=1\par
\tab\tab\tab else :\par
\tab\tab\tab\tab break\par
\tab\tab if not potential_items.is_empty():\par
\tab\tab\tab var selected_item:Item=potential_items.pick_random()\par
\tab\tab\tab if not offer_item.has(selected_item):\par
\tab\tab\tab\tab offer_item.append(selected_item)\par
\tab return offer_item\par
