\'d7\'dc\'bd\'e1\'d2\'bb\'cf\'c2\'a3\'basetter\'d3\'ef\'be\'e4\'d2\'b2\'d0\'e8\'d2\'aa\'d6\'f7\'b6\'af\'c8\'a5\'b8\'b3\'d6\'b5\'a3\'ac\'ca\'b5\'c0\'fd\'bb\'af\'b5\'c4TSCN\'b2\'a2\'c3\'bb\'d3\'d0\'c8\'ce\'ba\'ce\'d6\'b5\'d4\'da\'c0\'ef\'c3\'e6\'a1\'a3\cf3\par
\tab\tab var passive:=item as ItemPassive\par
\tab\tab passive.apply_passive()\par
\par
func creat_item_card()->ItemCard:\par
\tab var item_card:=Global.ITEM_CARD_SCENE.instantiate() as ItemCard\par
\tab item_card.item_card_selected.connect(_item_card_selected)\par
\tab return item_card\par
\par
func _item_card_selected(card:ItemCard)->void:\par
\tab context_card=card\par
\tab var can_combine:bool=false\par
\tab if card.item.item_type==Item.ItemType.WEAPON:\par
\tab\tab var count:int=0\par
\tab\tab for i :ItemWeapon in Global.equiped_weapon:\par
\tab\tab\tab if i.item_name==card.item.item_name:\par
\tab\tab\tab\tab count+=1\par
\tab\tab if count>=2:\par
\tab\tab\tab can_combine=true\par
\tab combine_button.disabled=not can_combine\par
\tab\tab\par
\par
func _on_combine_button_pressed() -> void:\par
\tab if not context_card:\par
\tab\tab return\par
\tab var temp_card:=context_card.item as ItemWeapon\par
\tab if temp_card.upgrade_to==null:\par
\tab\tab return\par
\tab var weapon_remove:Array[Weapon]=Global.player.current_weapons.filter(func(w:Weapon):\par
\tab\tab return w.data.item_name==temp_card.item_name).slice(0,2)\par
\tab var card_remove:=weapon_container.get_children().filter(func(c:ItemCard):\par
\tab\tab return c.item.item_name==temp_card.item_name).slice(0,2)\par
\tab if weapon_remove.size()<2 or card_remove.size()<2:\par
\tab\tab return\par
\tab for weapon:Weapon in weapon_remove:\par
\tab\tab Global.player.current_weapons.erase(weapon)\par
\tab\tab Global.equiped_weapon.erase(weapon.data)\par
\tab\tab weapon.queue_free()\par
\tab for card:ItemCard in card_remove:\par
\tab\tab card.queue_free()\par
\tab var up_weapon:ItemWeapon = load(temp_card.upgrade_to.resource_path)\par
\tab Global.player.equip_weapon(up_weapon)\par
\tab Global.equiped_weapon.append(up_weapon)\par
\tab var new_card:=creat_item_card()\par
\tab weapon_container.add_child(new_card)\par
\tab new_card.item=up_weapon\par
\tab context_card=null\par
\par
func _on_sell_button_pressed() -> void:\par
\tab if context_card==null:\par
\tab\tab return\par
\tab var clicked_weapon:=context_card.item as ItemWeapon\par
\tab var coins:=int(clicked_weapon.item_cost*0.75)\par
\tab var weapon_remove:Weapon=Global.player.current_weapons.filter(func(w:Weapon):\par
\tab\tab return w.data.item_name==clicked_weapon.item_name).front()\par
\tab if weapon_remove:\par
\tab\tab Global.player.current_weapons.erase(weapon_remove)\par
\tab\tab Global.equiped_weapon.erase(weapon_remove.data)\par
\tab\tab weapon_remove.queue_free()\par
\tab context_card.queue_free()\par
\tab context_card=null\par
\tab Global.coins+=coins\par
