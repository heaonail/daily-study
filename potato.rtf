\cf7\'d1\'a1\'d4\'f1\'ba\'c3player\'bd\'c7\'c9\'ab\'ba\'cdweapon\'ba\'f3\'a3\'ac\'d0\'c5\'ba\'c5\'b7\'a2\'b3\'f6\cf6\par
@export var players:Array[UnitStats]\par
@export var start_weapons:Array[ItemWeapon]\par
@onready var player_container: HBoxContainer = %PlayerContainer\par
@onready var weapon_container: HBoxContainer = %WeaponContainer\par
@onready var player_icon: TextureRect = %PlayerIcon\par
@onready var player_name: Label = %PlayerName\par
@onready var player_title: Label = %PlayerTitle\par
@onready var description: RichTextLabel = %Description\par
func _ready() -> void:\par
\tab for child in player_container.get_children():\par
\tab\tab child.queue_free()\par
\tab for child in weapon_container.get_children():\par
\tab\tab child.queue_free()\par
\tab show_player_info(false)\par
\tab load_players()\par
\par
func show_player_info(value:bool)->void:\par
\tab player_icon.visible=value\par
\tab player_name.visible=value\par
\tab player_title.visible=value\par
\tab description.visible=value\par
\par
func load_players()->void:\par
\tab if players.is_empty():\par
\tab\tab return\par
\tab for player in players:\par
\tab\tab var card:=Global.SELECTION_CARD_SCENE.instantiate() as SelectionCard\par
\tab\tab card.pressed.connect(_on_player_selected.bind(player))\par
\tab\tab player_container.add_child(card)\par
\tab\tab card.set_icon(player.icon)\par
\par
func _on_player_selected(player:UnitStats)->void:\par
\tab Global.main_player_selected=player\par
\tab show_player_info(true)\par
\tab player_icon.texture=player.icon\par
\tab player_name.text=player.name\par
\tab description.text="[code]Health:[color=green]%s[/color]\\nDamage:[color=green]%s[/color]\\nSpeed:[color=green]%s[/color]\\nLuck:[color=green]%s[/color]\\nBlock:[color=green]%s%%[/color][/code]" % [player.health,player.damage,player.speed,player.luck,player.block_chance]\par
\par
func load_weapons()->void:\par
\tab if start_weapons.is_empty():return\par
\tab for weapon in start_weapons:\par
\tab\tab var card:=Global.SELECTION_CARD_SCENE.instantiate() as SelectionCard\par
\tab\tab card.pressed.connect(_on_weapon_selected.bind(weapon))\par
\tab\tab weapon_container.add_child(card)\par
\tab\tab card.set_icon(weapon.item_icon)\par
\par
func _on_weapon_selected(weapon:ItemWeapon)->void:\par
\tab Global.main_weapon_selected=weapon\par
\par
func _on_continue_button_pressed() -> void:\par
\tab if not Global.main_player_selected and not Global.main_weapon_selected:\par
\tab\tab return\par
\tab on_selection_completed.emit()\par
